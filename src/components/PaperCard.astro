---
interface Props {
  title: string;
  authors: string[];
  abstract?: string;
}

const { title, authors, abstract } = Astro.props;
const id = `abstract-${title.slice(0, 20).replace(/\s+/g, '-').toLowerCase()}`;
---

<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 shadow-sm">
  <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 leading-snug">{title}</h3>
  <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">{authors.join(', ')}</p>
  {abstract && (
    <details class="mt-3 group">
      <summary class="cursor-pointer text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline list-none select-none">
        <span class="group-open:hidden">Show abstract</span>
        <span class="hidden group-open:inline">Hide abstract</span>
      </summary>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">{abstract}</p>
    </details>
  )}
</div>
