---
type SessionType = 'talk' | 'break' | 'session' | 'poster' | 'panel' | 'opening' | 'closing';

interface Props {
  time: string;
  title: string;
  type: SessionType;
  speaker?: string;
}

const { time, title, type, speaker } = Astro.props;

const borderColor: Record<SessionType, string> = {
  talk:    'border-indigo-500 dark:border-indigo-400',
  session: 'border-gray-500  dark:border-gray-400',
  poster:  'border-gray-400  dark:border-gray-500',
  panel:   'border-gray-700  dark:border-gray-300',
  break:   'border-gray-200  dark:border-gray-700',
  opening: 'border-gray-800  dark:border-gray-200',
  closing: 'border-gray-800  dark:border-gray-200',
};

const badge: Record<SessionType, string> = {
  talk:    'Invited Talk',
  session: 'Contributed Talks',
  poster:  'Poster Session',
  panel:   'Panel',
  break:   'Break',
  opening: 'Opening',
  closing: 'Closing',
};
---

<div class:list={['flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-6 border-l-2 pl-4 py-2.5', borderColor[type]]}>
  <span class="text-xs font-mono text-gray-400 dark:text-gray-500 shrink-0 w-32 pt-0.5">{time}</span>
  <div class="flex-1">
    <div class="flex flex-wrap items-baseline gap-2">
      <span class="text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500">{badge[type]}</span>
      <span class="text-sm font-semibold text-gray-900 dark:text-gray-100">{title}</span>
    </div>
    {speaker && (
      <p class="text-sm italic text-gray-500 dark:text-gray-400 mt-0.5">{speaker}</p>
    )}
  </div>
</div>
