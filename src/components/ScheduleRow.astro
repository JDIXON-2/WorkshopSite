---
type SessionType = 'talk' | 'break' | 'session' | 'poster' | 'panel' | 'keynote' | 'opening' | 'closing';

interface Props {
  time: string;
  title: string;
  type: SessionType;
  speaker?: string;
}

const { time, title, type, speaker } = Astro.props;

const typeStyles: Record<SessionType, string> = {
  keynote: 'bg-indigo-50 dark:bg-indigo-950/40 border-l-4 border-indigo-500',
  talk:    'bg-blue-50 dark:bg-blue-950/30 border-l-4 border-blue-400',
  session: 'bg-sky-50 dark:bg-sky-950/30 border-l-4 border-sky-400',
  poster:  'bg-violet-50 dark:bg-violet-950/30 border-l-4 border-violet-400',
  panel:   'bg-amber-50 dark:bg-amber-950/30 border-l-4 border-amber-400',
  break:   'bg-gray-50 dark:bg-gray-800/40 border-l-4 border-gray-300 dark:border-gray-600',
  opening: 'bg-emerald-50 dark:bg-emerald-950/30 border-l-4 border-emerald-400',
  closing: 'bg-rose-50 dark:bg-rose-950/30 border-l-4 border-rose-400',
};

const badge: Record<SessionType, string> = {
  keynote: 'Keynote',
  talk:    'Invited Talk',
  session: 'Papers',
  poster:  'Poster / Lunch',
  panel:   'Panel',
  break:   'Break',
  opening: 'Opening',
  closing: 'Closing',
};
---

<div class:list={['flex flex-col sm:flex-row sm:items-start gap-2 sm:gap-6 rounded-lg px-4 py-3', typeStyles[type]]}>
  <span class="text-xs font-mono text-gray-500 dark:text-gray-400 shrink-0 w-36 pt-0.5">{time}</span>
  <div class="flex-1">
    <div class="flex flex-wrap items-baseline gap-2">
      <span class="text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">{badge[type]}</span>
      <span class="text-sm font-medium text-gray-900 dark:text-gray-100">{title}</span>
    </div>
    {speaker && (
      <p class="text-xs text-indigo-600 dark:text-indigo-400 mt-0.5">{speaker}</p>
    )}
  </div>
</div>
