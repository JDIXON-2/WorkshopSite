---
// Steps are evenly spaced along the bar (not calendar-proportional) so labels
// don't bunch up. Remaining TBA dates below are placeholders until confirmed
// in the Call for Papers — update here when they are.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const checkpoints = [
  { label: 'Portal Opens',      dateLabel: 'Open',           iso: '2026-07-29T00:00:00Z' },
  { label: 'Abstract Deadline', dateLabel: '29 Aug 2026',    iso: '2026-08-29T23:00:00Z' },
  { label: 'Paper Deadline',    dateLabel: '05 Sep 2026',    iso: '2026-09-05T23:00:00Z' },
  { label: 'Notification',      dateLabel: 'October 2026',   iso: '2026-10-01T00:00:00Z' },
  { label: 'Camera-Ready',      dateLabel: 'November 2026',  iso: '2026-11-01T00:00:00Z' },
  { label: 'Workshop',          dateLabel: '12–13 Dec 2026', iso: '2026-12-12T00:00:00Z' },
];
---

<section class="mb-10 pb-10 border-b border-gray-200 dark:border-gray-700">
  <h2 class="text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-10">Key Dates</h2>

  <div id="kd-scroll" class="overflow-x-auto scrollbar-hide px-4">
    <div id="kd-container" class="relative min-w-[560px] h-40">
      <!-- Today pointer -->
      <div id="kd-today" class="absolute top-0 text-center transition-[left] duration-700" style="left: 0%; transform: translateX(-50%);">
        <p id="kd-today-label" class="text-[11px] font-semibold text-indigo-600 dark:text-indigo-400 whitespace-nowrap mb-1">Today</p>
        <div class="w-px h-3 bg-indigo-400 dark:bg-indigo-500 mx-auto"></div>
      </div>

      <!-- Track -->
      <div class="absolute left-0 right-0 h-1.5 bg-gray-200 dark:bg-gray-800 rounded-full" style="top: 4.75rem;">
        <div id="kd-fill" class="absolute left-0 top-0 h-full bg-indigo-600 dark:bg-indigo-500 rounded-full transition-[width] duration-700" style="width: 0%;"></div>
      </div>
      <div id="kd-dots"></div>

      <!-- Labels, alternating above/below the track -->
      <div id="kd-labels"></div>
    </div>
  </div>

  <a href={`${base}/call/`} class="inline-block mt-4 text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline underline-offset-2 decoration-1">
    Full Call for Papers &rarr;
  </a>
</section>

<style>
  .scrollbar-hide {
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* legacy Edge */
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none; /* Chrome, Safari */
  }
</style>

<script define:vars={{ checkpoints }}>
  const TRACK_TOP = 76;   // px, matches the 4.75rem inline style above (top edge of the track)
  const TRACK_CENTER = TRACK_TOP + 3; // track is 6px tall, so its middle is 3px lower
  const ABOVE_TOP = 31;   // leaves clearance above the dot for "above" labels
  const BELOW_TOP = 95;   // leaves clearance below the dot for "below" labels

  const fill = document.getElementById('kd-fill');
  const dotsHost = document.getElementById('kd-dots');
  const labelsHost = document.getElementById('kd-labels');
  const today = document.getElementById('kd-today');
  const todayLabel = document.getElementById('kd-today-label');

  const now = Date.now();
  const firstCheckpointMs = new Date(checkpoints[0].iso).getTime();

  const formatDate = (ms) =>
    new Date(ms).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

  // Before the portal opens, "today" leads the timeline as step zero.
  // Once it's passed, the portal-open date anchors the start instead.
  const beforePortalOpens = now < firstCheckpointMs;
  const items = beforePortalOpens
    ? [{ label: 'Today', dateLabel: formatDate(now), iso: new Date(now).toISOString(), isToday: true }, ...checkpoints]
    : checkpoints;

  const n = items.length;
  const stepPercent = (i) => (i / (n - 1)) * 100;

  // Find which segment "now" falls in, and how far along it (0-1), so the
  // marker snaps onto a checkpoint exactly or interpolates between two.
  let markerPercent = 0;
  if (now < firstCheckpointMs) {
    markerPercent = 0; // "Today" is step zero itself
  } else {
    let idx = n - 1;
    let frac = 0;
    for (let i = 0; i < n - 1; i++) {
      const a = new Date(items[i].iso).getTime();
      const b = new Date(items[i + 1].iso).getTime();
      if (now >= a && now <= b) {
        idx = i;
        frac = b === a ? 0 : (now - a) / (b - a);
        break;
      }
    }
    if (now >= new Date(items[n - 1].iso).getTime()) {
      idx = n - 1;
      frac = 0;
    }
    markerPercent = ((idx + frac) / (n - 1)) * 100;
  }

  fill.style.width = `${markerPercent}%`;

  // When "today" is itself the leading checkpoint, its label is already
  // drawn by the loop below — skip the floating pointer to avoid a duplicate.
  if (beforePortalOpens) {
    today.style.display = 'none';
  } else {
    today.style.left = `${markerPercent}%`;
    todayLabel.textContent = `Today · ${formatDate(now)}`;
    today.style.transform = markerPercent < 6 ? 'translateX(0%)' : markerPercent > 94 ? 'translateX(-100%)' : 'translateX(-50%)';
  }

  items.forEach((item, i) => {
    const percent = stepPercent(i);
    // Only the very first/last item anchors by its outer edge instead of
    // centering — the container can only auto-scroll rightward (scrollLeft
    // can't go negative), so a centered label at 0% would bleed off the
    // left edge with no way to reach it.
    const align = i === 0 ? 'left' : i === n - 1 ? 'right' : 'center';
    const passed = new Date(item.iso).getTime() <= now;
    const above = i % 2 === 0; // alternate labels above / below the track

    const dot = document.createElement('div');
    dot.className = `absolute w-3 h-3 rounded-full border-2 ${
      passed
        ? 'bg-indigo-600 dark:bg-indigo-500 border-indigo-600 dark:border-indigo-500'
        : 'bg-white dark:bg-gray-950 border-gray-400 dark:border-gray-500'
    }`;
    dot.style.left = `${percent}%`;
    dot.style.top = `${TRACK_CENTER}px`;
    dot.style.transform = 'translate(-50%, -50%)';
    dotsHost.appendChild(dot);

    // No-wrap + auto-width keeps every label the same one-line shape
    // regardless of text length, so labels of different lengths line up
    // evenly instead of some wrapping to two lines and others not.
    const labelWrap = document.createElement('div');
    labelWrap.className = `absolute whitespace-nowrap ${align === 'right' ? 'text-right' : align === 'left' ? 'text-left' : 'text-center'}`;
    labelWrap.style.left = `${percent}%`;
    labelWrap.style.top = above ? `${ABOVE_TOP}px` : `${BELOW_TOP}px`;
    labelWrap.style.transform = `translateX(${align === 'right' ? '-100%' : align === 'left' ? '0%' : '-50%'})`;
    labelWrap.innerHTML = above
      ? `<p class="text-xs font-mono text-indigo-600 dark:text-indigo-400">${item.dateLabel}</p>
         <p class="text-xs font-semibold text-gray-900 dark:text-gray-100">${item.label}</p>`
      : `<p class="text-xs font-semibold text-gray-900 dark:text-gray-100">${item.label}</p>
         <p class="text-xs font-mono text-indigo-600 dark:text-indigo-400">${item.dateLabel}</p>`;
    labelsHost.appendChild(labelWrap);
  });

  // Edge-hover auto-scroll: when the timeline overflows its box (only
  // possible on narrow screens now that the scrollbar is hidden), moving
  // the mouse near the left/right edge pans the view. Touch devices already
  // get native swipe-to-scroll from overflow-x-auto, no JS needed there.
  const scroller = document.getElementById('kd-scroll');
  const EDGE = 56;
  const MAX_SPEED = 9;
  let scrollSpeed = 0;

  scroller.addEventListener('mousemove', (e) => {
    const rect = scroller.getBoundingClientRect();
    const x = e.clientX - rect.left;
    if (x < EDGE) {
      scrollSpeed = -((EDGE - x) / EDGE) * MAX_SPEED;
    } else if (x > rect.width - EDGE) {
      scrollSpeed = ((x - (rect.width - EDGE)) / EDGE) * MAX_SPEED;
    } else {
      scrollSpeed = 0;
    }
  });
  scroller.addEventListener('mouseleave', () => {
    scrollSpeed = 0;
  });

  (function autoScrollLoop() {
    if (scrollSpeed !== 0) scroller.scrollLeft += scrollSpeed;
    requestAnimationFrame(autoScrollLoop);
  })();
</script>
