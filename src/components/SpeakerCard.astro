---
import { affiliationUrls } from '../data/affiliations';

interface Props {
  name: string;
  affiliation: string;
  talkTitle: string;
  role?: string;
  confirmed?: boolean;
  url?: string;
  photo?: string;
  bio?: string;
}

const { name, affiliation, talkTitle, role, confirmed, url, photo, bio } = Astro.props;
const affiliationUrl = affiliationUrls[affiliation];
const initials = name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();
---

<div class="flex gap-4 py-6 border-b border-gray-200 dark:border-gray-700 last:border-0">
  {photo ? (
    <img
      src={photo}
      alt={name}
      class="w-16 h-16 rounded-full object-cover shrink-0 border border-gray-200 dark:border-gray-600 mt-0.5"
    />
  ) : (
    <div class="w-16 h-16 rounded-full shrink-0 mt-0.5 flex items-center justify-center text-lg font-bold border border-gray-200 dark:border-gray-600 text-gray-500 dark:text-gray-400">
      {initials}
    </div>
  )}

  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 mb-0.5">
      {url ? (
        <a href={url} target="_blank" rel="noopener noreferrer" class="font-semibold text-gray-900 dark:text-gray-100 hover:underline underline-offset-2 decoration-1">
          {name}
        </a>
      ) : (
        <span class="font-semibold text-gray-900 dark:text-gray-100">{name}</span>
      )}
      {confirmed && (
        <span class="text-xs italic text-green-700 dark:text-green-400">(confirmed)</span>
      )}
      {role && <span class="text-sm italic text-gray-500 dark:text-gray-400">{role}</span>}
    </div>

    {affiliationUrl ? (
      <a href={affiliationUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-indigo-600 dark:text-indigo-400 hover:underline underline-offset-2 decoration-1">{affiliation}</a>
    ) : (
      <p class="text-sm text-indigo-600 dark:text-indigo-400">{affiliation}</p>
    )}

    <p class="mt-2 text-sm italic text-gray-600 dark:text-gray-400 leading-snug">&ldquo;{talkTitle}&rdquo;</p>
    {bio && <p class="mt-1.5 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">{bio}</p>}
  </div>
</div>
