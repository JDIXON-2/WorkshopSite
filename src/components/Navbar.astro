---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { href: `${base}/`,           label: 'Home' },
  { href: `${base}/call/`,      label: 'Call for Papers' },
  { href: `${base}/speakers/`,  label: 'Speakers' },
  { href: `${base}/program/`,   label: 'Program' },
  { href: `${base}/papers/`,    label: 'Papers' },
  { href: `${base}/organisers/`,label: 'Organisers' },
  { href: `${base}/sponsors/`,  label: 'Sponsors' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-950">
  <nav class="max-w-4xl mx-auto px-4 sm:px-8 h-12 flex items-center gap-0.5 overflow-x-auto">
    <a
      href={`${base}/`}
      class="mr-5 text-sm font-bold text-gray-900 dark:text-gray-100 shrink-0 whitespace-nowrap tracking-tight"
      aria-label="Home"
    >
      FLPT 2026
    </a>

    {links.map(({ href, label }) => {
      const isActive = currentPath === href || (href !== `${base}/` && currentPath.startsWith(href));
      return (
        <a
          href={href}
          class:list={[
            'px-2.5 py-1 text-sm whitespace-nowrap transition-colors',
            isActive
              ? 'font-semibold text-gray-900 dark:text-gray-100 underline underline-offset-4 decoration-1'
              : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100',
          ]}
        >
          {label}
        </a>
      );
    })}

    <button
      id="theme-toggle"
      aria-label="Toggle dark mode"
      class="ml-auto shrink-0 p-1.5 text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors"
    >
      <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" class="hidden dark:block w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
        <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
      <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" class="block dark:hidden w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </nav>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
