---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

type Tier = 'gold' | 'silver' | 'bronze';

const all = (await getCollection('sponsors')).sort((a, b) => a.data.order - b.data.order);

const tiers: Tier[] = ['gold', 'silver', 'bronze'];
const tierLabels: Record<Tier, string> = {
  gold:   'Gold',
  silver: 'Silver',
  bronze: 'Bronze',
};
---

<Layout title="Sponsors">
  <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white mb-2">Sponsors</h1>
  <p class="text-gray-500 dark:text-gray-400 mb-8">We gratefully acknowledge the support of our sponsors.</p>

  {tiers.map(tier => {
    const group = all.filter(s => s.data.tier === tier);
    if (group.length === 0) return null;
    return (
      <section class="mb-10 pb-10 border-b border-gray-200 dark:border-gray-700">
        <h2 class="text-base font-bold text-gray-800 dark:text-gray-200 mb-5">
          {tierLabels[tier]} Sponsors
        </h2>
        <div class="flex flex-wrap gap-6">
          {group.map(s => (
            <a
              href={s.data.url ?? '#'}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 hover:border-gray-400 dark:hover:border-gray-500 transition-colors min-h-[100px] min-w-[160px]"
            >
              {s.data.logo ? (
                <img src={s.data.logo} alt={s.data.name} class="max-h-14 object-contain" />
              ) : (
                <span class="text-sm font-medium text-gray-500 dark:text-gray-400">{s.data.name}</span>
              )}
            </a>
          ))}
        </div>
      </section>
    );
  })}

  <!-- Special thanks -->
  <section class="mb-10 pb-10 border-b border-gray-200 dark:border-gray-700">
    <h2 class="text-base font-bold text-gray-900 dark:text-white mb-3">Special Thanks</h2>
    <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-5">
      Organising events of this kind draws on the time, expertise, and goodwill of a great many people. We would like to extend our particular thanks to:
    </p>
    <div class="flex flex-wrap gap-5">
      <a href="https://www.robots.ox.ac.uk/~sjrob/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4">
        <img src="https://www.robots.ox.ac.uk/~sjrob/steve2019.jpg" alt="Stephen Roberts" class="w-12 h-12 rounded-full object-cover shrink-0 border border-gray-200 dark:border-gray-600" />
        <div>
          <p class="font-semibold text-gray-900 dark:text-gray-100 text-sm hover:underline underline-offset-2 decoration-1">Stephen Roberts</p>
          <p class="text-sm text-indigo-600 dark:text-indigo-400">University of Oxford</p>
        </div>
      </a>
    </div>
  </section>

  <section>
    <h3 class="font-semibold text-gray-700 dark:text-gray-300 mb-1">Interested in sponsoring FLPT 2026?</h3>
    <p class="text-sm text-gray-500 dark:text-gray-400">Contact us at <a href="mailto:flpt2026@example.com" class="text-indigo-600 dark:text-indigo-400 hover:underline underline-offset-2 decoration-1">flpt2026@example.com</a> for our sponsorship prospectus.</p>
  </section>
</Layout>
