---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Nice Try">
  <div class="flex flex-col items-center justify-center text-center py-24 gap-6">
    <img
      src="https://cdn001.tintin.com/public/tintin/img/news/6370/10_LICORNE%20P46%20C1.jpg"
      alt="Nice try"
      class="max-w-sm w-full rounded object-cover"
    />
    <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white">Nice Try</h1>
    <p class="text-gray-500 dark:text-gray-400 max-w-md">
      Path traversal isn't going to work here. Head back to safety.
    </p>
    <a
      href={`${base}/`}
      class="inline-flex items-center gap-1.5 border border-gray-900 dark:border-gray-100 text-gray-900 dark:text-gray-100 px-4 py-1.5 text-sm hover:bg-gray-900 dark:hover:bg-gray-100 hover:text-white dark:hover:text-gray-900 transition-colors"
    >
      &larr; Back to Home
    </a>
  </div>
</Layout>
