---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ScheduleRow from '../components/ScheduleRow.astro';

const items = (await getCollection('schedule')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Program">
  <div class="flex flex-wrap items-start justify-between gap-4 mb-2">
    <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Workshop Program</h1>
    <button
      disabled
      aria-disabled="true"
      title="Available when the exact workshop date is confirmed"
      class="inline-flex items-center gap-2 border border-gray-200 dark:border-gray-700 text-gray-400 dark:text-gray-600 px-4 py-1.5 text-sm cursor-not-allowed"
    >
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      Add to Calendar · Coming soon
    </button>
  </div>
  <p class="text-gray-500 dark:text-gray-400 mb-2">12&ndash;13 Dec 2026 &middot; Paris, France</p>
  <p class="text-sm text-amber-600 dark:text-amber-400 mb-6">This is a preliminary programme — the workshop day, venue, and speaker slot order are all provisional and subject to change.</p>

  <!-- Schedule overview -->
  <table class="w-full text-sm border-collapse mb-8">
    <thead>
      <tr class="border-b-2 border-gray-300 dark:border-gray-600 text-left">
        <th class="pb-2 pr-8 font-semibold text-gray-700 dark:text-gray-300">Format</th>
        <th class="pb-2 font-semibold text-gray-700 dark:text-gray-300">Details</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
      {[
        { label: 'Invited Talks',     detail: '5 × 40 min + 5 min Q&A' },
        { label: 'Contributed Talks', detail: '5 × 10 min presentations' },
        { label: 'Poster Sessions',   detail: '2 × 60 min' },
      ].map(({ label, detail }) => (
        <tr>
          <td class="py-2 pr-8 font-medium text-gray-900 dark:text-gray-100">{label}</td>
          <td class="py-2 text-gray-600 dark:text-gray-400">{detail}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="flex flex-col gap-2">
    {items.map(item => (
      <ScheduleRow
        time={item.data.time}
        title={item.data.title}
        type={item.data.type}
        speaker={item.data.speaker}
      />
    ))}
  </div>

  <!-- Legend -->
  <div class="mt-6 flex flex-wrap gap-x-6 gap-y-1 text-xs text-gray-400 dark:text-gray-500">
    {[
      { label: 'Invited Talk',     border: 'border-indigo-500 dark:border-indigo-400' },
      { label: 'Contributed Talk', border: 'border-gray-500 dark:border-gray-400' },
      { label: 'Poster / Lunch',   border: 'border-gray-400 dark:border-gray-500' },
      { label: 'Break',            border: 'border-gray-200 dark:border-gray-700' },
    ].map(({ label, border }) => (
      <span class="flex items-center gap-1.5">
        <span class:list={['w-3 h-3 border-l-2', border]}></span>
        {label}
      </span>
    ))}
  </div>
</Layout>
