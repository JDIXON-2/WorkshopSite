---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ScheduleRow from '../components/ScheduleRow.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = (await getCollection('schedule')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Program">
  <div class="flex flex-wrap items-start justify-between gap-4 mb-2">
    <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 dark:text-white">Workshop Program</h1>
    <a
      href={`${base}/flpt2026.ics`}
      download="flpt2026.ics"
      class="inline-flex items-center gap-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 hover:bg-gray-50 dark:hover:bg-gray-800 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 transition-colors shadow-sm"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      Add to Calendar (.ics)
    </a>
  </div>
  <p class="text-gray-500 dark:text-gray-400 mb-2">December 2026 &middot; Country Convention Centre</p>
  <p class="text-sm text-amber-600 dark:text-amber-400 mb-10">All times are in Pacific Standard Time (PST). Subject to change.</p>

  <div class="flex flex-col gap-2">
    {items.map(item => (
      <ScheduleRow
        time={item.data.time}
        title={item.data.title}
        type={item.data.type}
        speaker={item.data.speaker}
      />
    ))}
  </div>

  <!-- Legend -->
  <div class="mt-8 flex flex-wrap gap-3 text-xs">
    {[
      { label: 'talk',     color: 'bg-indigo-500' },
      { label: 'Invited Talk',color: 'bg-blue-400' },
      { label: 'Papers',      color: 'bg-sky-400' },
      { label: 'Poster',      color: 'bg-violet-400' },
      { label: 'Panel',       color: 'bg-amber-400' },
      { label: 'Break',       color: 'bg-gray-400' },
    ].map(({ label, color }) => (
      <span class="flex items-center gap-1.5 text-gray-500 dark:text-gray-400">
        <span class:list={['w-2.5 h-2.5 rounded-sm', color]}></span>
        {label}
      </span>
    ))}
  </div>
</Layout>
