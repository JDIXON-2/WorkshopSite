---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
  title: string;
  description?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title,
  description = 'Workshop on Foundations of LLM Post-Training in Changing Environments — SomeConference 2026',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="min-h-screen bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title} | FLPT 2026</title>
    <!-- Runs before paint to avoid flash -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="flex flex-col min-h-screen font-sans antialiased">
    <Navbar />
    <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 py-10">
      <slot />
    </main>
    <footer class="border-t border-gray-200 dark:border-gray-800 mt-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500 dark:text-gray-400">
        <p>Foundations of LLM Post-Training in Changing Environments &mdash; SomeConference 2026</p>
        <div class="text-right">
          <p>Contact: <a href="mailto:flpt2026@example.com" class="hover:underline">flpt2026@example.com</a></p>
          <p>Built by: <a href="mailto:james.dixon@eng.ox.ac.uk" class="hover:underline">james.dixon@eng.ox.ac.uk</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
