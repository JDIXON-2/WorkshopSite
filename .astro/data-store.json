"photo":343,"order":20},[],"liu.md","peyre",{"id":356,"data":358,"filePath":363,"digest":364,"rendered":365,"legacyId":372},{"name":359,"affiliation":360,"role":340,"title":361,"url":362,"order":105},"Gabriel Peyré","École Normale Supérieure","CNRS Research Director","https://www.gpeyre.com","src/content/organisers/peyre.md","eed3b04df2948811",{"html":128,"metadata":366},{"headings":367,"localImagePaths":368,"remoteImagePaths":369,"frontmatter":370,"imagePaths":371},[],[],[],{"name":359,"affiliation":360,"title":361,"url":362,"role":340,"order":105},[],"peyre.md","shi",{"id":373,"data":375,"body":381,"filePath":382,"digest":383,"rendered":384,"legacyId":392},{"name":376,"affiliation":377,"role":340,"title":378,"url":379,"photo":380,"order":62},"Chengchun Shi","London School of Economics and Political Science","Associate Professor","https://callmespring.github.io/","https://callmespring.github.io/profile0.jpg","His research focuses on the statistical foundations of reinforcement learning, causal inference, and LLMs. Recipient of the Peter Gavin Hall IMS Early Career Prize, the IMS Tweedie Award, and the Royal Statistical Society Research Prize. Organiser of the [2026 Sanya Workshop on Causality and ML](https://tsimf.tsinghua.edu.cn/info/1107/1159.htm) and the [MLStat 2026 Conference](https://ml-stat.github.io/MLSTAT2026/).","src/content/organisers/shi.md","e4986fddcf860801",{"html":385,"metadata":386},"\u003Cp>His research focuses on the statistical foundations of reinforcement learning, causal inference, and LLMs. Recipient of the Peter Gavin Hall IMS Early Career Prize, the IMS Tweedie Award, and the Royal Statistical Society Research Prize. Organiser of the \u003Ca href=\"https://tsimf.tsinghua.edu.cn/info/1107/1159.htm\">2026 Sanya Workshop on Causality and ML\u003C/a> and the \u003Ca href=\"https://ml-stat.github.io/MLSTAT2026/\">MLStat 2026 Conference\u003C/a>.\u003C/p>",{"headings":387,"localImagePaths":388,"remoteImagePaths":389,"frontmatter":390,"imagePaths"